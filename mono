        // Biztonsági mentés (.json) exportálása (alapértelmezetten adatok.json néven a GitHub szinkronhoz)
        function exportBackupJSON() {
            const nowIso = new Date().toISOString();
            const payload = {
                app: 'MONO',
                version: 1,
                exportedAt: nowIso,
                cardOrder: sanitizeCardOrder(appState.cardOrder),
                items: appState.items
            };

            const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = url;
            link.download = 'adatok.json';
            document.body.appendChild(link);
            link.click();
            link.remove();
            URL.revokeObjectURL(url);

            appState.hasUnsavedExport = false;
            appState.lastExportedAt = nowIso;
            saveState(false);
            showToast('adatok.json letöltve (feltölthető a GitHub mappába)');
        }

        // JSON adatok tisztítása és érvényesítése
        function parseAndSanitizeItems(parsed) {
            const rawItems = Array.isArray(parsed) ? parsed : (parsed && parsed.items);
            if (!Array.isArray(rawItems)) {
                return null;
            }
            const validCategories = Object.keys(CATEGORY_LABELS);
            return rawItems
                .filter(item =>
                    item &&
                    validCategories.includes(item.category) &&
                    typeof item.name === 'string' &&
                    item.name.trim().length > 0 &&
                    Number.isFinite(Number(item.amount)) &&
                    Number(item.amount) > 0
                )
                .map((item, idx) => ({
                    id: typeof item.id === 'string' ? item.id : `imp-${Date.now()}-${idx}`,
                    category: item.category,
                    name: item.name.trim().slice(0, 50),
                    amount: Math.abs(Math.round(Number(item.amount)))
                }));
        }

        // Automatikus betöltés a mellette lévő adatok.json fájlból (GitHub Pages / szerver esetén)
        async function tryLoadRemoteAdatokJSON() {
            // Helyi file:// megnyitásnál a böngésző CORS miatt tiltja a fetch-et
            if (window.location.protocol === 'file:') return;

            try {
                const response = await fetch(`./adatok.json?t=${Date.now()}`, { cache: 'no-store' });
                if (!response.ok) return;

                const parsed = await response.json();
                const cleaned = parseAndSanitizeItems(parsed);
                if (!cleaned) return;

                const remoteExportedAt = (parsed && parsed.exportedAt) ? String(parsed.exportedAt) : null;
                const localExportedAt = appState.lastExportedAt ? String(appState.lastExportedAt) : null;

                // Betöltjük, ha még nincs helyi adatunk, vagy ha a GitHubon lévő adatok.json frissebb
                const shouldApplyRemote =
                    appState.items.length === 0 ||
                    (remoteExportedAt && (!localExportedAt || remoteExportedAt > localExportedAt));

                if (shouldApplyRemote && cleaned.length > 0) {
                    appState.items = cleaned;
                    if (parsed && Array.isArray(parsed.cardOrder)) {
                        appState.cardOrder = sanitizeCardOrder(parsed.cardOrder);
                        applyCardOrder();
                    }
                    appState.hasUnsavedExport = false;
                    appState.lastExportedAt = remoteExportedAt || new Date().toISOString();
                    saveState(false);
                    renderAll();
                    showToast(`Automatikusan betöltve az adatok.json fájlból (${cleaned.length} tétel)`);
                }
            } catch (err) {
                // Ha még nincs feltöltve adatok.json a mappába, csendben a helyi tárhelyet használjuk
            }
        }

        // Biztonsági mentés (.json) visszatöltése
        function importBackupJSON(file) {
            if (!file) return;
            const reader = new FileReader();
            reader.onload = (event) => {
                try {
                    const parsed = JSON.parse(event.target.result);
                    const cleaned = parseAndSanitizeItems(parsed);
                    if (!cleaned) {
                        throw new Error('Érvénytelen fájlformátum');
                    }

                    appState.items = cleaned;
                    if (parsed && Array.isArray(parsed.cardOrder)) {
                        appState.cardOrder = sanitizeCardOrder(parsed.cardOrder);
                        applyCardOrder();
                    }
                    appState.hasUnsavedExport = false;
                    appState.lastExportedAt = new Date().toISOString();
                    saveState(false);
                    renderAll();
                    showToast(`${cleaned.length} tétel sikeresen betöltve`);
                } catch (err) {
                    console.error('Importálási hiba:', err);
                    showToast('Hibás vagy sérült .json mentési fájl', 'error');
                }
            };
            reader.readAsText(file);
        }

        // PWA mobilapp ikon (PNG) és manifest dinamikus generálása
        function initMobileAppAssets() {
            try {
                function createMonolithIconDataURL(size) {
                    const canvas = document.createElement('canvas');
                    canvas.width = size;
                    canvas.height = size;
                    const ctx = canvas.getContext('2d');
                    if (!ctx) return '';

                    // Sötét háttér finom átmenettel
                    const bgGrad = ctx.createLinearGradient(0, 0, size, size);
                    bgGrad.addColorStop(0, '#181a20');
                    bgGrad.addColorStop(1, '#090a0d');
                    ctx.fillStyle = bgGrad;
                    ctx.fillRect(0, 0, size, size);

                    const s = size / 28;

                    // Bal monolit oszlop
                    ctx.fillStyle = '#ffffff';
                    ctx.beginPath();
                    ctx.moveTo(5 * s, 21 * s);
                    ctx.lineTo(5 * s, 7 * s);
                    ctx.lineTo(11.5 * s, 14 * s);
                    ctx.lineTo(11.5 * s, 21 * s);
                    ctx.closePath();
                    ctx.fill();

                    // Jobb monolit oszlop
                    ctx.fillStyle = '#a1a1aa';
                    ctx.beginPath();
                    ctx.moveTo(23 * s, 21 * s);
                    ctx.lineTo(23 * s, 7 * s);
                    ctx.lineTo(16.5 * s, 14 * s);
                    ctx.lineTo(16.5 * s, 21 * s);
                    ctx.closePath();
                    ctx.fill();

                    // Középső ciánkék ék
                    ctx.fillStyle = '#38bdf8';
                    ctx.beginPath();
                    ctx.moveTo(14 * s, 11.2 * s);
                    ctx.lineTo(17.2 * s, 7.8 * s);
                    ctx.lineTo(14 * s, 15.2 * s);
                    ctx.lineTo(10.8 * s, 7.8 * s);
                    ctx.closePath();
                    ctx.fill();

                    return canvas.toDataURL('image/png');
                }

                const icon180 = createMonolithIconDataURL(180);
                const icon512 = createMonolithIconDataURL(512);

                const appleLink = document.getElementById('apple-touch-icon-link');
                if (appleLink && icon180) {
                    appleLink.href = icon180;
                }

                const manifest = {
                    name: 'MONO',
                    short_name: 'MONO',
                    start_url: '.',
                    display: 'standalone',
                    background_color: '#090a0d',
                    theme_color: '#090a0d',
                    icons: icon512 ? [{
                        src: icon512,
                        sizes: '512x512',
                        type: 'image/png'
                    }] : []
                };

                const manifestBlob = new Blob([JSON.stringify(manifest)], { type: 'application/manifest+json' });
                const manifestLink = document.getElementById('web-manifest-link');
                if (manifestLink) {
                    manifestLink.href = URL.createObjectURL(manifestBlob);
                }
            } catch (err) {
                console.warn('Mobilapp ikon inicializálási figyelmeztetés:', err);
            }
        }

