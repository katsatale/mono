<!DOCTYPE html>
<html lang="hu" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>MONO — Fix költség kalkulátor</title>
    <!-- iOS és Android PWA teljes képernyős mobilapp beállítások -->
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="MONO">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#09090b">
    <link id="apple-touch-icon-link" rel="apple-touch-icon" sizes="180x180">
    <link id="web-manifest-link" rel="manifest">
    <!-- Tailwind CSS betöltése -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: #090a0d;
            color: #f4f4f5;
            padding-bottom: env(safe-area-inset-bottom);
        }

        /* iOS notch / Dynamic Island safe-area támogatás a ragadós fejlécben */
        .safe-header {
            padding-top: env(safe-area-inset-top);
        }

        /* iOS Safari automatikus ráközelítés (auto-zoom) megakadályozása gépeléskor */
        @media screen and (max-width: 768px) {
            input[type="text"],
            input[type="number"],
            select {
                font-size: 16px !important;
            }
        }

        /* Tabuláris számok a pontos Ft igazításhoz */
        .tabular-nums {
            font-variant-numeric: tabular-nums;
        }

        /* Műszaki micro-grid háttértextúra a fejléchez */
        .header-micro-grid {
            background-image: 
                linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
            background-size: 24px 24px;
        }

        /* Szám mező nyilainak elrejtése a letisztult megjelenésért */
        input[type="number"]::-webkit-inner-spin-button,
        input[type="number"]::-webkit-outer-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }
        input[type="number"] {
            -moz-appearance: textfield;
        }

        /* Finom hover és fókuszfények a kártyákhoz és mezőkhöz */
        .monolith-card {
            background: linear-gradient(180deg, rgba(24, 26, 32, 0.92) 0%, rgba(17, 19, 24, 0.96) 100%);
            border: 1px solid rgba(255, 255, 255, 0.07);
            box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.6), inset 0 1px 0 0 rgba(255, 255, 255, 0.04);
            transition: border-color 0.22s ease, box-shadow 0.22s ease, transform 0.22s ease;
        }
        .monolith-card:hover {
            border-color: rgba(255, 255, 255, 0.15);
            box-shadow: 0 14px 36px -10px rgba(0, 0, 0, 0.75), 0 0 0 1px rgba(255, 255, 255, 0.04), inset 0 1px 0 0 rgba(255, 255, 255, 0.08);
        }

        .monolith-input {
            background-color: rgba(9, 10, 13, 0.85);
            border: 1px solid rgba(255, 255, 255, 0.08);
            transition: border-color 0.18s ease, box-shadow 0.18s ease, background-color 0.18s ease;
        }
        .monolith-input:hover {
            border-color: rgba(255, 255, 255, 0.16);
        }
        .monolith-input:focus {
            outline: none;
            background-color: #090a0d;
            border-color: rgba(255, 255, 255, 0.32);
            box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.06);
        }

        /* Finom, sötét módú görgetősáv a kártyákon belüli listákhoz */
        .custom-scroll::-webkit-scrollbar {
            width: 4px;
        }
        .custom-scroll::-webkit-scrollbar-track {
            background: transparent;
        }
        .custom-scroll::-webkit-scrollbar-thumb {
            background-color: rgba(161, 161, 170, 0.22);
            border-radius: 9999px;
        }
        .custom-scroll::-webkit-scrollbar-thumb:hover {
            background-color: rgba(161, 161, 170, 0.4);
        }

        @keyframes modalFadeIn {
            from { opacity: 0; transform: scale(0.97) translateY(4px); }
            to { opacity: 1; transform: scale(1) translateY(0); }
        }
        .animate-modal {
            animation: modalFadeIn 0.16s ease-out forwards;
        }

        /* Drag & Drop kártya mozgatás stílusai */
        .drag-handle {
            cursor: grab;
            touch-action: none;
        }
        .drag-handle:active {
            cursor: grabbing;
        }
        .monolith-card.is-dragging {
            opacity: 0.45;
            transform: scale(0.985);
            border-color: rgba(56, 189, 248, 0.5);
        }
        .monolith-card.drag-over {
            border-color: rgba(56, 189, 248, 0.75);
            box-shadow: 0 0 0 2px rgba(56, 189, 248, 0.28), 0 18px 40px -10px rgba(0, 0, 0, 0.85);
        }
    </style>
</head>
<body class="min-h-screen flex flex-col antialiased selection:bg-zinc-100 selection:text-zinc-950">

    <!-- FEJLÉC -->
    <header class="sticky top-0 z-30 bg-[#090a0d]/85 backdrop-blur-xl border-b border-white/[0.07] header-micro-grid safe-header">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 py-4 flex flex-col md:flex-row md:items-center md:justify-between gap-4">

            <!-- Bal oldali blokk: Geometrikus MONO embléma, főcím és alcím -->
            <div class="flex items-center gap-3.5 min-w-0">
                <div class="relative w-11 h-11 rounded-2xl bg-gradient-to-br from-[#1f222b] via-[#12141a] to-[#090a0d] text-white flex items-center justify-center shrink-0 shadow-lg shadow-black/60 ring-1 ring-white/15 overflow-hidden group">
                    <div class="absolute inset-0 bg-gradient-to-tr from-white/[0.02] via-transparent to-white/[0.12]"></div>
                    <svg class="w-6 h-6 relative z-10" viewBox="0 0 28 28" fill="none">
                        <!-- Bal monolit oszlop -->
                        <path d="M5 21V7L11.5 14V21H5Z" fill="url(#mono-grad-1)"/>
                        <!-- Jobb monolit oszlop -->
                        <path d="M23 21V7L16.5 14V21H23Z" fill="url(#mono-grad-2)"/>
                        <!-- Középső ék / csúcs -->
                        <path d="M14 11.2L17.2 7.8L14 15.2L10.8 7.8L14 11.2Z" fill="#38bdf8"/>
                        <defs>
                            <linearGradient id="mono-grad-1" x1="5" y1="7" x2="11.5" y2="21" gradientUnits="userSpaceOnUse">
                                <stop stop-color="#FFFFFF"/>
                                <stop offset="1" stop-color="#A1A1AA"/>
                            </linearGradient>
                            <linearGradient id="mono-grad-2" x1="23" y1="7" x2="16.5" y2="21" gradientUnits="userSpaceOnUse">
                                <stop stop-color="#E4E4E7"/>
                                <stop offset="1" stop-color="#71717A"/>
                            </linearGradient>
                        </defs>
                    </svg>
                </div>
                <div class="min-w-0">
                    <div class="flex items-center gap-2">
                        <h1 class="text-xl sm:text-2xl font-black tracking-[0.14em] text-white leading-none">
                            MONO
                        </h1>
                        <span class="text-[10px] font-bold uppercase tracking-widest px-1.5 py-0.5 rounded bg-white/[0.06] text-zinc-400 border border-white/10">
                            BUDGET
                        </span>
                    </div>
                    <p class="text-xs text-zinc-400 mt-1 truncate">
                        Havi fix költség és előfizetés követő
                    </p>
                </div>
            </div>

            <!-- Jobb oldali blokk: Állapotjelző jelvény + Export / Import gombok -->
            <div class="flex flex-wrap items-center md:justify-end gap-2.5 shrink-0">
                <!-- Kattintható biztonsági mentés állapotjelző -->
                <button id="btn-backup-status" type="button"
                    class="inline-flex items-center gap-2 px-3 py-2 rounded-xl bg-emerald-500/10 border border-emerald-500/25 text-xs font-semibold text-emerald-400 hover:bg-emerald-500/20 transition cursor-pointer whitespace-nowrap"
                    title="Minden adatod szinkronban van az utolsó mentéssel.">
                    <span class="relative flex h-2 w-2 shrink-0">
                        <span id="backup-status-ping" class="hidden animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
                        <span id="backup-status-dot" class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
                    </span>
                    <span id="backup-status-text">Mentés naprakész</span>
                </button>

                <!-- Export gomb -->
                <button id="btn-export" type="button"
                    class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-semibold bg-zinc-100 text-zinc-950 hover:bg-white transition cursor-pointer shadow-sm whitespace-nowrap">
                    <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5m0 0l5-5m-5 5V3"/>
                    </svg>
                    Export (.json)
                </button>

                <!-- Import gomb -->
                <label for="input-import"
                    class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-semibold bg-white/[0.04] text-zinc-200 border border-white/10 hover:bg-white/[0.08] hover:border-white/20 transition cursor-pointer whitespace-nowrap">
                    <svg class="w-3.5 h-3.5 text-zinc-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M16 8l-4-4m0 0L8 8m4-4v12"/>
                    </svg>
                    Import
                </label>
                <input id="input-import" type="file" accept=".json,application/json" class="hidden">
            </div>

        </div>
    </header>

    <!-- Értesítési konténer (alert() helyett) -->
    <div id="toast-container" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <!-- FŐ TARTALOM -->
    <main class="flex-1 max-w-6xl w-full mx-auto px-4 sm:px-6 py-6 sm:py-8">

        <!-- FELSŐ ÖSSZESÍTŐ SÁV: KÉT KÁRTYA -->
        <section class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
            <!-- 1. Összesítő kártya: Havi fix kiadás -->
            <div class="monolith-card relative overflow-hidden rounded-2xl p-5 sm:p-6 flex flex-col justify-between">
                <div class="absolute inset-x-0 top-0 h-[1px] bg-gradient-to-r from-transparent via-white/25 to-transparent"></div>
                <div class="flex items-center justify-between gap-2">
                    <span class="text-xs font-semibold uppercase tracking-wider text-zinc-400">
                        Összes fix kiadás / hó
                    </span>
                    <span id="badge-total-items" class="text-xs font-medium text-zinc-300 bg-white/[0.05] border border-white/10 px-2.5 py-0.5 rounded-full tabular-nums whitespace-nowrap">
                        0 tétel
                    </span>
                </div>
                <div id="display-total-fixed" class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white tabular-nums mt-3">
                    0 <span class="text-lg sm:text-xl font-semibold text-zinc-500">Ft</span>
                </div>
            </div>

            <!-- 2. Összesítő kártya: Éves vetített összeg -->
            <div class="monolith-card relative overflow-hidden rounded-2xl p-5 sm:p-6 flex flex-col justify-between">
                <div class="absolute inset-x-0 top-0 h-[1px] bg-gradient-to-r from-transparent via-white/15 to-transparent"></div>
                <div class="flex items-center justify-between gap-2">
                    <span class="text-xs font-semibold uppercase tracking-wider text-zinc-400">
                        Éves vetített kiadás
                    </span>
                    <span class="text-xs font-medium text-zinc-500">
                        12 hónapra vetítve
                    </span>
                </div>
                <div id="display-annual-fixed" class="text-3xl sm:text-4xl font-extrabold tracking-tight text-zinc-200 tabular-nums mt-3">
                    0 <span class="text-lg sm:text-xl font-semibold text-zinc-500">Ft</span>
                </div>
            </div>
        </section>

        <!-- ESZTÉTIKUS ELVÁLASZTÓ SÁV -->
        <div class="my-6 sm:my-7 flex items-center gap-4" aria-hidden="true">
            <div class="h-px flex-1 bg-gradient-to-r from-transparent via-white/[0.08] to-white/[0.08]"></div>
            <span class="text-[11px] font-semibold uppercase tracking-widest text-zinc-500">
                Kategóriák &amp; Tételek • Átrendezhető
            </span>
            <div class="h-px flex-1 bg-gradient-to-l from-transparent via-white/[0.08] to-white/[0.08]"></div>
        </div>

        <!-- FŐ KÖLTSÉG BLOKKOK RÁCSA (RÖGZÍTETT h-[340px] MAGASSÁGÚ, SZABADON ÁTRENDEZHETŐ KÁRTYÁK) -->
        <section id="cards-grid" class="grid grid-cols-1 lg:grid-cols-2 gap-6">

            <!-- 1. KÁRTYA: STREAMING SZOLGÁLTATÁSOK (PIROSAS AKCENTUS) -->
            <div data-card-category="streaming" class="monolith-card relative overflow-hidden rounded-2xl p-5 sm:p-6 h-[340px] flex flex-col">
                <div class="absolute inset-x-0 top-0 h-[2px] bg-gradient-to-r from-transparent via-rose-500/75 to-transparent"></div>

                <div class="flex items-center justify-between gap-2.5 pb-2.5 shrink-0">
                    <div class="flex items-center gap-2 min-w-0">
                        <div class="drag-handle p-1 -ml-1 rounded-lg text-zinc-500 hover:text-zinc-200 hover:bg-white/[0.06] transition shrink-0" title="Húzd a kártyát az átrendezéshez" aria-label="Kártya mozgatása">
                            <svg class="w-4 h-4" viewBox="0 0 16 16" fill="currentColor">
                                <circle cx="5.5" cy="3.5" r="1.25"/><circle cx="10.5" cy="3.5" r="1.25"/>
                                <circle cx="5.5" cy="8" r="1.25"/><circle cx="10.5" cy="8" r="1.25"/>
                                <circle cx="5.5" cy="12.5" r="1.25"/><circle cx="10.5" cy="12.5" r="1.25"/>
                            </svg>
                        </div>
                        <div class="w-8 h-8 rounded-lg bg-rose-500/10 border border-rose-500/25 text-rose-400 flex items-center justify-center shrink-0">
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="2" y="4" width="20" height="14" rx="2"/>
                                <path d="M8 21h8M12 18v3M10 9l5 3-5 3V9z" fill="currentColor" stroke="none"/>
                            </svg>
                        </div>
                        <h2 class="text-base font-bold tracking-tight text-white truncate">
                            Streaming szolgáltatások
                        </h2>
                    </div>
                    <span id="subtotal-streaming" class="text-sm font-bold text-zinc-100 tabular-nums whitespace-nowrap shrink-0 bg-white/[0.04] border border-white/10 px-3 py-1 rounded-lg">
                        0 <span class="text-xs font-medium text-zinc-400">Ft / hó</span>
                    </span>
                </div>

                <div class="w-full h-[3px] bg-white/[0.05] rounded-full overflow-hidden mb-3 shrink-0" title="Arány az összes fix kiadáson belül">
                    <div id="bar-streaming" class="h-full bg-rose-500/80 rounded-full transition-all duration-300" style="width: 0%"></div>
                </div>

                <form id="form-streaming" class="space-y-2 shrink-0">
                    <div class="grid grid-cols-1 sm:grid-cols-12 gap-2">
                        <div class="sm:col-span-7">
                            <label class="sr-only" for="input-streaming-name">Szolgáltatás neve</label>
                            <input id="input-streaming-name" type="text" required maxlength="50"
                                placeholder="Megnevezés (pl. Netflix, Disney+, Spotify)"
                                class="monolith-input w-full rounded-xl px-3.5 py-2 text-sm text-zinc-100 placeholder-zinc-500">
                        </div>

                        <div class="sm:col-span-5 relative">
                            <label class="sr-only" for="input-streaming-amount">Összeg (Ft)</label>
                            <input id="input-streaming-amount" type="number" required min="1" step="1" placeholder="Összeg"
                                class="monolith-input w-full rounded-xl pl-3.5 pr-8 py-2 text-sm font-medium text-zinc-100 placeholder-zinc-500 tabular-nums">
                            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-zinc-500 pointer-events-none">Ft</span>
                        </div>
                    </div>

                    <button type="submit"
                        class="w-full bg-zinc-100 hover:bg-white text-zinc-950 text-xs font-bold py-2 px-4 rounded-xl transition cursor-pointer flex items-center justify-center gap-1.5 shadow-xs">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                        </svg>
                        Összeg mentése
                    </button>
                </form>

                <div class="border-t border-white/[0.07] my-2.5 shrink-0"></div>

                <ul id="list-streaming" class="flex-1 overflow-y-auto pr-1 divide-y divide-white/[0.06] custom-scroll"></ul>
            </div>

            <!-- 2. KÁRTYA: ALBÉRLET ÉS REZSI (HIDEG KÉK AKCENTUS) -->
            <div data-card-category="housing" class="monolith-card relative overflow-hidden rounded-2xl p-5 sm:p-6 h-[340px] flex flex-col">
                <div class="absolute inset-x-0 top-0 h-[2px] bg-gradient-to-r from-transparent via-sky-500/75 to-transparent"></div>

                <div class="flex items-center justify-between gap-2.5 pb-2.5 shrink-0">
                    <div class="flex items-center gap-2 min-w-0">
                        <div class="drag-handle p-1 -ml-1 rounded-lg text-zinc-500 hover:text-zinc-200 hover:bg-white/[0.06] transition shrink-0" title="Húzd a kártyát az átrendezéshez" aria-label="Kártya mozgatása">
                            <svg class="w-4 h-4" viewBox="0 0 16 16" fill="currentColor">
                                <circle cx="5.5" cy="3.5" r="1.25"/><circle cx="10.5" cy="3.5" r="1.25"/>
                                <circle cx="5.5" cy="8" r="1.25"/><circle cx="10.5" cy="8" r="1.25"/>
                                <circle cx="5.5" cy="12.5" r="1.25"/><circle cx="10.5" cy="12.5" r="1.25"/>
                            </svg>
                        </div>
                        <div class="w-8 h-8 rounded-lg bg-sky-500/10 border border-sky-500/25 text-sky-400 flex items-center justify-center shrink-0">
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3 10.5L12 3l9 7.5V20a1 1 0 01-1 1h-5v-6H9v6H4a1 1 0 01-1-1v-9.5z"/>
                            </svg>
                        </div>
                        <h2 class="text-base font-bold tracking-tight text-white truncate">
                            Albérlet és rezsi
                        </h2>
                    </div>
                    <span id="subtotal-housing" class="text-sm font-bold text-zinc-100 tabular-nums whitespace-nowrap shrink-0 bg-white/[0.04] border border-white/10 px-3 py-1 rounded-lg">
                        0 <span class="text-xs font-medium text-zinc-400">Ft / hó</span>
                    </span>
                </div>

                <div class="w-full h-[3px] bg-white/[0.05] rounded-full overflow-hidden mb-3 shrink-0" title="Arány az összes fix kiadáson belül">
                    <div id="bar-housing" class="h-full bg-sky-500/80 rounded-full transition-all duration-300" style="width: 0%"></div>
                </div>

                <form id="form-housing" class="space-y-2 shrink-0">
                    <div class="grid grid-cols-1 sm:grid-cols-12 gap-2">
                        <div class="sm:col-span-7">
                            <input id="input-housing-name" type="text" required maxlength="50"
                                placeholder="Megnevezés (pl. Albérlet, Villanyszámla)"
                                class="monolith-input w-full rounded-xl px-3.5 py-2 text-sm text-zinc-100 placeholder-zinc-500">
                        </div>
                        <div class="sm:col-span-5 relative">
                            <input id="input-housing-amount" type="number" required min="1" step="1" placeholder="Összeg"
                                class="monolith-input w-full rounded-xl pl-3.5 pr-8 py-2 text-sm font-medium text-zinc-100 placeholder-zinc-500 tabular-nums">
                            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-zinc-500 pointer-events-none">Ft</span>
                        </div>
                    </div>

                    <button type="submit"
                        class="w-full bg-zinc-100 hover:bg-white text-zinc-950 text-xs font-bold py-2 px-4 rounded-xl transition cursor-pointer flex items-center justify-center gap-1.5 shadow-xs">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                        </svg>
                        Összeg mentése
                    </button>
                </form>

                <div class="border-t border-white/[0.07] my-2.5 shrink-0"></div>

                <ul id="list-housing" class="flex-1 overflow-y-auto pr-1 divide-y divide-white/[0.06] custom-scroll"></ul>
            </div>

            <!-- 3. KÁRTYA: HITELEK (MELEG BOROSTYÁN AKCENTUS) -->
            <div data-card-category="loans" class="monolith-card relative overflow-hidden rounded-2xl p-5 sm:p-6 h-[340px] flex flex-col">
                <div class="absolute inset-x-0 top-0 h-[2px] bg-gradient-to-r from-transparent via-amber-500/75 to-transparent"></div>

                <div class="flex items-center justify-between gap-2.5 pb-2.5 shrink-0">
                    <div class="flex items-center gap-2 min-w-0">
                        <div class="drag-handle p-1 -ml-1 rounded-lg text-zinc-500 hover:text-zinc-200 hover:bg-white/[0.06] transition shrink-0" title="Húzd a kártyát az átrendezéshez" aria-label="Kártya mozgatása">
                            <svg class="w-4 h-4" viewBox="0 0 16 16" fill="currentColor">
                                <circle cx="5.5" cy="3.5" r="1.25"/><circle cx="10.5" cy="3.5" r="1.25"/>
                                <circle cx="5.5" cy="8" r="1.25"/><circle cx="10.5" cy="8" r="1.25"/>
                                <circle cx="5.5" cy="12.5" r="1.25"/><circle cx="10.5" cy="12.5" r="1.25"/>
                            </svg>
                        </div>
                        <div class="w-8 h-8 rounded-lg bg-amber-500/10 border border-amber-500/25 text-amber-400 flex items-center justify-center shrink-0">
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
