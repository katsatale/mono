                if (!item) return;

                const newName = document.getElementById('edit-item-name').value.trim();
                const newAmount = Math.abs(Math.round(Number(document.getElementById('edit-item-amount').value)));

                if (!newName || !Number.isFinite(newAmount) || newAmount <= 0) return;

                item.name = newName;
                item.amount = newAmount;
                closeEditModal();
                saveState(true);
                renderAll();
                showToast(`${newName} frissítve (${formatHUF(newAmount)})`);
            });

            // Modális ablakok bezárása háttérre kattintással vagy Escape gombbal
            document.getElementById('modal-delete').addEventListener('click', (e) => {
                if (e.target.id === 'modal-delete') closeDeleteModal();
            });
            document.getElementById('modal-edit').addEventListener('click', (e) => {
                if (e.target.id === 'modal-edit') closeEditModal();
            });
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                    closeDeleteModal();
                    closeEditModal();
                }
            });

            // Export, Import és állapotjelző gombok
            document.getElementById('btn-export').addEventListener('click', exportBackupJSON);
            document.getElementById('btn-backup-status').addEventListener('click', exportBackupJSON);
            document.getElementById('input-import').addEventListener('change', (e) => {
                const file = e.target.files && e.target.files[0];
                if (file) {
                    importBackupJSON(file);
                    e.target.value = '';
                }
            });
        });
    </script>
</body>
</html>
