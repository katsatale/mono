        // Állapot betöltése a localStorage-ból
        function loadState() {
            try {
                const raw = localStorage.getItem(STORAGE_KEY);
                if (!raw) return;
                const parsed = JSON.parse(raw);
                if (parsed && Array.isArray(parsed.items)) {
                    appState.items = parsed.items.filter(item =>
                        item &&
                        typeof item.id === 'string' &&
                        typeof item.category === 'string' &&
                        typeof item.name === 'string' &&
                        Number.isFinite(Number(item.amount)) &&
                        Number(item.amount) > 0
                    );
                    appState.hasUnsavedExport = Boolean(parsed.hasUnsavedExport);
                    appState.lastExportedAt = parsed.lastExportedAt || null;
                    if (Array.isArray(parsed.cardOrder)) {
                        appState.cardOrder = sanitizeCardOrder(parsed.cardOrder);
                    }
                }
            } catch (err) {
                console.warn('Nem sikerült beolvasni a mentett adatokat:', err);
            }
        }

        // Kártyasorrend érvényesítése (mind az 5 kategória pontosan egyszer szerepeljen)
        function sanitizeCardOrder(order) {
            if (!Array.isArray(order)) return [...DEFAULT_CARD_ORDER];
            const valid = order.filter(cat => DEFAULT_CARD_ORDER.includes(cat));
            const unique = [...new Set(valid)];
            DEFAULT_CARD_ORDER.forEach(cat => {
                if (!unique.includes(cat)) unique.push(cat);
            });
            return unique;
        }

        // Kártyák DOM sorrendjének alkalmazása az elmentett állapot szerint
        function applyCardOrder() {
            const grid = document.getElementById('cards-grid');
            if (!grid) return;
            const order = sanitizeCardOrder(appState.cardOrder);
            order.forEach(cat => {
                const card = grid.querySelector(`[data-card-category="${cat}"]`);
                if (card) {
                    grid.appendChild(card);
                }
            });
        }

        // Aktuális DOM sorrend kiolvasása és mentése
        function persistCurrentGridOrder() {
            const grid = document.getElementById('cards-grid');
            if (!grid) return;
            const currentOrder = Array.from(grid.querySelectorAll('[data-card-category]'))
                .map(el => el.dataset.cardCategory);
            const sanitized = sanitizeCardOrder(currentOrder);
            const changed = JSON.stringify(sanitized) !== JSON.stringify(appState.cardOrder);
            appState.cardOrder = sanitized;
            if (changed) {
                saveState(true);
                showToast('Kártyák sorrendje elmentve');
            }
        }

        // Szabadon árendezhető Drag & Drop (egér + érintőképernyő) inicializálása
        function initCardDragAndDrop() {
            const grid = document.getElementById('cards-grid');
            if (!grid) return;

            let draggedCard = null;
            let activeTouchCard = null;

            const cards = Array.from(grid.querySelectorAll('[data-card-category]'));

            cards.forEach(card => {
                const handle = card.querySelector('.drag-handle');
                if (!handle) return;

                // Asztali böngésző: csak a fogantyúról indítva válik húzhatóvá, így a szövegkijelölés és űrlapok zavartalanok
                handle.addEventListener('pointerdown', () => {
                    card.setAttribute('draggable', 'true');
                });
                window.addEventListener('pointerup', () => {
                    card.removeAttribute('draggable');
                });

                card.addEventListener('dragstart', (e) => {
                    draggedCard = card;
                    card.classList.add('is-dragging');
                    if (e.dataTransfer) {
                        e.dataTransfer.effectAllowed = 'move';
                        e.dataTransfer.setData('text/plain', card.dataset.cardCategory);
                    }
                });

                card.addEventListener('dragend', () => {
                    card.classList.remove('is-dragging');
                    card.removeAttribute('draggable');
                    cards.forEach(c => c.classList.remove('drag-over'));
                    draggedCard = null;
                    persistCurrentGridOrder();
                });

                card.addEventListener('dragover', (e) => {
                    e.preventDefault();
                    if (!draggedCard || draggedCard === card) return;

                    const rect = card.getBoundingClientRect();
                    const isAfter = (e.clientY - rect.top) > rect.height / 2 ||
                                    ((e.clientX - rect.left) > rect.width / 2 && Math.abs(e.clientY - rect.top - rect.height / 2) < rect.height * 0.35);

                    if (isAfter) {
                        grid.insertBefore(draggedCard, card.nextSibling);
                    } else {
                        grid.insertBefore(draggedCard, card);
                    }
                });

                card.addEventListener('dragenter', (e) => {
                    e.preventDefault();
                    if (draggedCard && draggedCard !== card) {
                        card.classList.add('drag-over');
                    }
                });

                card.addEventListener('dragleave', () => {
                    card.classList.remove('drag-over');
                });

                card.addEventListener('drop', (e) => {
                    e.preventDefault();
                    card.classList.remove('drag-over');
                });

                // Mobil / érintőképernyő támogatás a fogantyún keresztül
                handle.addEventListener('touchstart', (e) => {
                    if (e.touches.length !== 1) return;
                    activeTouchCard = card;
                    card.classList.add('is-dragging');
                }, { passive: true });

                handle.addEventListener('touchmove', (e) => {
                    if (!activeTouchCard || e.touches.length !== 1) return;
                    e.preventDefault();
                    const touch = e.touches[0];
                    const elemBelow = document.elementFromPoint(touch.clientX, touch.clientY);
                    const targetCard = elemBelow ? elemBelow.closest('[data-card-category]') : null;

                    cards.forEach(c => c.classList.remove('drag-over'));

                    if (targetCard && targetCard !== activeTouchCard && grid.contains(targetCard)) {
                        targetCard.classList.add('drag-over');
                        const rect = targetCard.getBoundingClientRect();
                        const insertAfter = touch.clientY > rect.top + rect.height / 2;
                        if (insertAfter) {
                            grid.insertBefore(activeTouchCard, targetCard.nextSibling);
                        } else {
                            grid.insertBefore(activeTouchCard, targetCard);
                        }
                    }
                }, { passive: false });

                handle.addEventListener('touchend', () => {
                    if (!activeTouchCard) return;
                    activeTouchCard.classList.remove('is-dragging');
                    cards.forEach(c => c.classList.remove('drag-over'));
                    activeTouchCard = null;
                    persistCurrentGridOrder();
                });
            });
        }

        // Új tétel felvétele
        function addItem(category, name, amount) {
            const cleanName = String(name || '').trim();
            const numAmount = Math.abs(Math.round(Number(amount)));

            if (!cleanName || !Number.isFinite(numAmount) || numAmount <= 0) {
                return false;
            }

            appState.items.push({
                id: 'id-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 6),
                category,
                name: cleanName,
                amount: numAmount
            });

            saveState(true);
            renderAll();
            showToast(`${cleanName} mentve (${formatHUF(numAmount)})`);
            return true;
        }

