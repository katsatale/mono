    <script>
        /**
         * MONO — Személyes fix költség kalkulátor
         * Sötét téma, 0 Ft-os kiindulási állapot, előre megadott példa adatok nélkül.
         */

        const STORAGE_KEY = 'monolith_budget_v1';

        const CATEGORY_LABELS = {
            streaming: 'Streaming szolgáltatások',
            housing: 'Albérlet és rezsi',
            loans: 'Hitelek',
            telecom: 'Telefonszámlák és internet',
            business: 'Vállalkozói költségek'
        };

        const DEFAULT_CARD_ORDER = ['streaming', 'housing', 'loans', 'telecom', 'business'];

        // Teljesen üres kiinduló állapot (példa adatok nélkül, biztonsági mentés és kártyasorrend követéssel)
        let appState = {
            items: [],
            cardOrder: [...DEFAULT_CARD_ORDER],
            hasUnsavedExport: false,
            lastExportedAt: null
        };

        let pendingDeleteId = null;
        let pendingEditId = null;

        // Szám formázása szóközökkel (pl. "245 000")
        function formatNumberHU(value) {
            const num = Math.round(Number(value) || 0);
            return new Intl.NumberFormat('hu-HU', {
                maximumFractionDigits: 0
            }).format(num);
        }

        // Magyar forint formázás szövegként (pl. "245 000 Ft")
        function formatHUF(value) {
            return `${formatNumberHU(value)} Ft`;
        }

        // XSS elleni védelem felhasználói szövegekhez
        function escapeHTML(str) {
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        // Diszkrét értesítő buborék megjelenítése (alert() helyett)
        function showToast(message, type = 'success') {
            const container = document.getElementById('toast-container');
            if (!container) return;

            const toast = document.createElement('div');
            const isError = type === 'error';
            toast.className = `pointer-events-auto px-4 py-2.5 rounded-xl text-xs font-semibold shadow-xl border transition-all duration-200 flex items-center gap-2 ${
                isError
                    ? 'bg-rose-950/95 border-rose-500/40 text-rose-200'
                    : 'bg-[#161820]/95 border-white/15 text-zinc-100'
            }`;
            toast.innerHTML = `
                <span class="w-1.5 h-1.5 rounded-full ${isError ? 'bg-rose-400' : 'bg-sky-400'} shrink-0"></span>
                <span>${escapeHTML(message)}</span>
            `;

            container.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(6px)';
                setTimeout(() => toast.remove(), 220);
            }, 2600);
        }

        // Teljes felület és összesítők újrarenderelése
        function renderAll() {
            const categories = Object.keys(CATEGORY_LABELS);
            let totalMonthly = 0;
            const categoryTotals = {};

            categories.forEach(cat => {
                const items = appState.items.filter(item => item.category === cat);
                const sum = items.reduce((acc, item) => acc + (Number(item.amount) || 0), 0);
                categoryTotals[cat] = sum;
                totalMonthly += sum;

                const subtotalEl = document.getElementById(`subtotal-${cat}`);
                if (subtotalEl) {
                    subtotalEl.innerHTML = `${formatNumberHU(sum)} <span class="text-xs font-medium text-zinc-400">Ft / hó</span>`;
                }

                const listEl = document.getElementById(`list-${cat}`);
                if (listEl) {
                    if (items.length === 0) {
                        listEl.innerHTML = `
                            <li class="py-6 text-center text-xs text-zinc-500">
                                Még nincs rögzített tétel ebben a kategóriában
                            </li>`;
                    } else {
                        listEl.innerHTML = items.map(item => `
                            <li class="py-2.5 flex items-center justify-between gap-2.5 group">
                                <div class="flex items-center gap-2.5 min-w-0">
                                    ${cat === 'streaming' ? getStreamingBadgeHTML(item.name) : ''}
                                    <span class="text-sm font-medium text-zinc-200 truncate" title="${escapeHTML(item.name)}">
                                        ${escapeHTML(item.name)}
                                    </span>
                                </div>
                                <div class="flex items-center gap-2 shrink-0">
                                    <span class="text-sm font-bold text-white tabular-nums">
                                        ${formatHUF(item.amount)}
                                    </span>
                                    <div class="flex items-center gap-1 opacity-80 group-hover:opacity-100 transition">
                                        <button type="button" data-action="edit" data-id="${escapeHTML(item.id)}"
                                            class="p-1.5 rounded-lg text-zinc-400 hover:text-white hover:bg-white/[0.08] transition cursor-pointer"
                                            title="Módosítás" aria-label="Tétel módosítása">
                                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                            </svg>
                                        </button>
                                        <button type="button" data-action="delete" data-id="${escapeHTML(item.id)}"
                                            class="p-1.5 rounded-lg text-zinc-400 hover:text-rose-400 hover:bg-rose-500/10 transition cursor-pointer"
                                            title="Törlés" aria-label="Tétel törlése">
                                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <polyline points="3 6 5 6 21 6"/>
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6m5 0V4a1 1 0 011-1h2a1 1 0 011 1v2"/>
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                            </li>
                        `).join('');
                    }
                }
            });

            // Arányjelző sávok frissítése
            categories.forEach(cat => {
                const barEl = document.getElementById(`bar-${cat}`);
                if (barEl) {
                    const pct = totalMonthly > 0 ? Math.round((categoryTotals[cat] / totalMonthly) * 100) : 0;
                    barEl.style.width = `${pct}%`;
                }
            });

            // Felső összesítő kártyák frissítése
            const totalFixedEl = document.getElementById('display-total-fixed');
            if (totalFixedEl) {
                totalFixedEl.innerHTML = `${formatNumberHU(totalMonthly)} <span class="text-lg sm:text-xl font-semibold text-zinc-500">Ft</span>`;
            }

            const annualFixedEl = document.getElementById('display-annual-fixed');
            if (annualFixedEl) {
                annualFixedEl.innerHTML = `${formatNumberHU(totalMonthly * 12)} <span class="text-lg sm:text-xl font-semibold text-zinc-500">Ft</span>`;
            }

            const badgeItemsEl = document.getElementById('badge-total-items');
            if (badgeItemsEl) {
                badgeItemsEl.textContent = `${appState.items.length} tétel`;
            }
        }

        // Inline SVG márkajelzések a streaming szolgáltatásokhoz
        function getStreamingBadgeHTML(serviceName) {
            const normalized = String(serviceName || '').trim().toLowerCase();
            switch (normalized) {
                case 'netflix':
